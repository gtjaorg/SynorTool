<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Content Include="Tools/*;ThirdParty/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/BrandIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/MenuBarIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
  </ItemGroup>
  <Target Name="BuildChatWeb" BeforeTargets="Build">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Web" Command="npm run build" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Web/dist/index.html;$(MSBuildProjectDirectory)/Web/dist/translation.html;$(MSBuildProjectDirectory)/Web/dist/settings.html" DestinationFolder="$(TargetDir)Web" />
  </Target>
  <Target Name="BuildNativePanel" AfterTargets="Build">
    <Exec Command="xcrun swiftc -parse-as-library -emit-library -module-name SynorAppleTranslation -target arm64-apple-macos26.0 -Xlinker -install_name -Xlinker @rpath/libSynorAppleTranslation.dylib &quot;$(MSBuildProjectDirectory)/AppleTranslation.swift&quot; -o &quot;$(TargetDir)libSynorAppleTranslation.dylib&quot;" />
    <Exec Command="xcrun clang -fobjc-arc -Wall -Wextra -Werror -mmacosx-version-min=26.0 -dynamiclib -framework AppKit -framework ApplicationServices -framework Security -framework WebKit -framework QuartzCore &quot;$(MSBuildProjectDirectory)/NativePanel.m&quot; &quot;$(MSBuildProjectDirectory)/SynorMarkdown.m&quot; -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(TargetDir)libSynorPanel.dylib&quot;" />
  </Target>
</Project>
